{
  "name": "apexprep-backend",
  "version": "0.1.0",
  "description": "ApexPrep adaptive learning + question practice platform — API (modular monolith)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e",
    "test:sql": "tsx scripts/run-sql-tests.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:remote": "tsx scripts/seed-remote.ts",
    "db:reset": "tsx src/database/migrate.ts --reset && tsx src/database/seed.ts",
    "db:status": "tsx src/database/migrate.ts --status",
    "engine:upgrade": "tsx scripts/upgrade-engine-params.ts",
    "beta:learners": "tsx scripts/make-beta-learners.ts",
    "beta:load": "tsx scripts/load-test.ts",
    "ai:verify-fallback": "tsx scripts/verify-ai-fallback.ts",
    "dev:cleanup-ai": "tsx scripts/cleanup-live-verification.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "rootDir": ".",
        "testEnvironment": "node",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "testMatch": [
          "<rootDir>/test/unit/**/*.spec.ts",
          "<rootDir>/src/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "tsconfig.test.json"
            }
          ]
        }
      },
      {
        "displayName": "e2e",
        "rootDir": ".",
        "testEnvironment": "node",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "testMatch": [
          "<rootDir>/test/e2e/**/*.e2e-spec.ts"
        ],
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "tsconfig.test.json"
            }
          ]
        },
        "globalSetup": "<rootDir>/test/e2e/global-setup.ts",
        "setupFiles": [
          "<rootDir>/test/e2e/setup-env.ts"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/test/e2e/setup-timeout.ts"
        ]
      }
    ]
  }
}
