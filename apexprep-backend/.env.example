# -----------------------------------------------------------------------------
# ApexPrep backend — environment template
# Copy to .env and fill in. Never commit .env. Every value is validated at boot
# (src/config/env.schema.ts); the API refuses to start on a missing or weak value.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Comma-separated allow-list of exact browser origins (no wildcards: cookies are sent). Unset outside
# production = the four local Vite origins below. Production must list its own https:// origin(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Number of reverse-proxy hops to trust for client IPs (0 when running directly)
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
LOG_LEVEL=log

# --- PostgreSQL 16 + pgvector (docker-compose.yml reads the POSTGRES_* values) ---
POSTGRES_USER=apexprep
POSTGRES_PASSWORD=
POSTGRES_DB=apexprep
POSTGRES_PORT=5432
# Must match the values above, e.g. postgres://apexprep:<password>@localhost:5432/apexprep
DATABASE_URL=
DATABASE_POOL_MAX=10
# Used by `npm run test:sql` and e2e tests; created automatically by docker/postgres/init
TEST_DATABASE_URL=

# --- Background processing (PostgreSQL; no Redis needed) ---
# postgres = durable (claimed with a lease, recovered after a restart); memory = in-process only (nothing survives a restart)
# INGESTION_QUEUE_DRIVER=postgres
# INGESTION_POLL_SECONDS=10
# INGESTION_LEASE_SECONDS=120
# Close mock-test papers whose deadline passed when nobody touched them (0 = off)
# SWEEP_INTERVAL_SECONDS=60
# Optional. Nothing reads it: background jobs run on PostgreSQL (INGESTION_QUEUE_DRIVER=postgres, the default).
# REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=apexprep-api
JWT_AUDIENCE=apexprep-web
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies are required in production; localhost is treated as secure by browsers
REFRESH_COOKIE_SECURE=true
# strict when frontend and API share a site (localhost:5173 + localhost:3000 do); none if they don't
REFRESH_COOKIE_SAMESITE=strict
# Also return the refresh token in JSON (non-browser clients only). Keep false for the web app.
REFRESH_TOKEN_IN_BODY=false
# argon2id cost (OWASP minimum: 19 MiB memory, 2 iterations, 1 lane)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# Lock an account for AUTH_LOCKOUT_MINUTES after this many consecutive failed logins
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_MINUTES=15
# Refuse login until the email address is verified
REQUIRE_VERIFIED_EMAIL=false
EMAIL_VERIFICATION_TTL_HOURS=24
# Tenant used by register/login when the request does not name one (the dev seed creates dev-sandbox)
DEFAULT_TENANT_SLUG=dev-sandbox
# Web app base URL, used in email links
APP_PUBLIC_URL=http://localhost:5173
# Overrides APP_PUBLIC_URL for email links when set. Must be https:// in production.
FRONTEND_URL=http://localhost:5173
# Reset links are FRONTEND_URL + PASSWORD_RESET_PATH + ?token=..., valid for PASSWORD_RESET_TTL_MINUTES (5-120)
PASSWORD_RESET_PATH=/reset-password
PASSWORD_RESET_TTL_MINUTES=30

# --- Email ---
# console: logs that an email would be sent, links redacted (development only)
# memory:  kept in-process (tests)  |  smtp: really sends (production)  |  none: sends nothing
# (MAIL_TRANSPORT, the older name for this setting, is still read when MAIL_PROVIDER is unset.)
MAIL_PROVIDER=console
MAIL_FROM_NAME=ApexPrep
# Required for smtp: an address your SMTP provider is authorised to send from (SPF/DKIM set up for its domain)
MAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
# Set both or neither. Keep these in the deployment's secret store, never in source control.
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS (usually port 465). false = STARTTLS (usually 587), which production enforces.
SMTP_SECURE=false

# --- Rate limiting ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# --- AI provider (server-side only; keys are never sent to the frontend) ---
# gemini | claude | none   (none = AI features return 503 "not configured")
AI_PROVIDER=none
# Tried only when the primary fails in a way another provider could fix, and only when named
# here with its own key present: a paid provider is never called by inference. Must differ
# from AI_PROVIDER, or be none.
AI_FALLBACK_PROVIDER=none
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Left blank, each provider uses its own default (gemini-2.5-flash / claude-sonnet-4-5).
AI_EXPLANATION_MODEL=
# Claude cannot embed: semantic retrieval needs a provider that can, in either slot.
AI_EMBEDDING_MODEL=
# Must match the dimension the ANN index in migration 0007 was built for.
AI_EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048

# --- Uploads ---
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=50
UPLOAD_MAX_PAGES=1000

# --- Development seed only (npm run db:seed refuses to run when NODE_ENV=production) ---
SEED_ADMIN_EMAIL=admin@dev.apexprep.local
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=student@dev.apexprep.local
SEED_STUDENT_PASSWORD=
# Optional: a SUPER_ADMIN in the separate "apexprep-platform" tenant (log in with tenantSlug=apexprep-platform)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
